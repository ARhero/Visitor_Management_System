# Copy to api/.env for running the API outside Docker. docker-compose.yml sets these itself.

ENV=dev                                   # dev | test | prod (prod hides /api/docs)
PUBLIC_WEB_URL=http://localhost:5173      # used to build QR check-in links
CORS_ORIGINS=["http://localhost:5173"]

# Two roles on purpose (see README > Tenant isolation)
DATABASE_URL=postgresql+asyncpg://vms_app:vms_app@localhost:5432/vms        # restricted, RLS applies
DATABASE_ADMIN_URL=postgresql+asyncpg://vms:vms@localhost:5432/vms          # owner: migrations, login, platform, jobs
DB_APP_ROLE=vms_app                       # role that migrations grant to / write RLS policies for

REDIS_URL=redis://localhost:6379/0        # "memory://" = in-process fake (no-Docker dev/tests only)

# Auth. Generate a real secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-insecure-change-me-0123456789abcdef
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
COOKIE_SECURE=false                       # true in production (HTTPS)

LOGIN_RATE_LIMIT=10                       # attempts per login identifier per window
LOGIN_RATE_WINDOW_SECONDS=300
SIGNUP_RATE_LIMIT=5                       # per IP per hour

# Data residency
DEFAULT_DATA_REGION=ap-south-1
DEFAULT_TIMEZONE=Asia/Kolkata

# Object storage for visitor photos. MinIO locally, S3 ap-south-1 in production.
STORAGE_BACKEND=s3                        # s3 | local ("local" = files under LOCAL_MEDIA_DIR; dev without MinIO)
LOCAL_MEDIA_DIR=.media
S3_ENDPOINT_URL=http://localhost:9000     # leave empty for AWS S3
S3_PUBLIC_ENDPOINT_URL=                   # host in photo links if browsers reach storage differently
S3_REGION=ap-south-1
S3_BUCKET=vms-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Visitor passes are signed with Ed25519. Production: set a PEM private key (PKCS8);
# generate with: python -c "from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey as K; from cryptography.hazmat.primitives import serialization as s; print(K.generate().private_bytes(s.Encoding.PEM, s.PrivateFormat.PKCS8, s.NoEncryption()).decode())"
# Empty in dev = a key is generated into PASS_KEY_FILE on first use.
PASS_SIGNING_KEY=
PASS_KEY_FILE=.pass_signing_key.pem

# WhatsApp
WHATSAPP_PROVIDER=mock                    # mock (dev inbox at /dev/whatsapp) | meta (README > WhatsApp) | off (no WhatsApp: README section 6)
WHATSAPP_APP_SECRET=                      # Meta app secret: verifies X-Hub-Signature-256 on webhooks
WHATSAPP_VERIFY_TOKEN=dev-verify-token    # echoed back during Meta's webhook verification
WHATSAPP_PHONE_NUMBER_ID=                 # meta: the shared business number's ID
WHATSAPP_ACCESS_TOKEN=                    # meta: System User token (whatsapp_business_messaging)
WHATSAPP_WABA_ID=                         # meta: only for scripts.whatsapp_templates create/status
WHATSAPP_GRAPH_URL=https://graph.facebook.com/v21.0
WHATSAPP_TEMPLATE_PREFIX=vms_             # template names are <prefix><key>, e.g. vms_visit_request

# Visitor OTP
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5                        # wrong codes before the code is killed
OTP_RESEND_SECONDS=30
OTP_PER_PHONE_LIMIT=3                     # sends per phone per 10 minutes
OTP_PER_IP_LIMIT=20
OTP_PER_GATE_LIMIT=200
VISITOR_TOKEN_TTL_MINUTES=30              # time to fill the form after verifying

# Background jobs (message retries, escalation, expiry). Empty = run inside the API when
# REDIS_URL=memory:// (no worker); with real Redis the ARQ worker runs them.
JOBS_IN_PROCESS=
SWEEP_INTERVAL_SECONDS=15

# Seed script
SEED_PASSWORD=demo-password-123

# --- Phone alerts (web push) for hosts ---
# Empty in dev = a key is generated into api/.vapid_key.pem. Required in production. Create one with
#   cd api && uv run python -c "from py_vapid import Vapid; v=Vapid(); v.generate_keys(); print(v.private_pem().decode())"
# and paste it on one line, with \n for the line breaks. Changing it means everyone turns alerts on again.
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com    # a contact address the browsers' push services can use
